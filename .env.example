# ===== Keep Your Eyes Shut pipeline settings =====
# Copy this file to ".env" and fill in the values. Don't share .env with anyone.
# Use the NEW keys made for this channel (not the AI Wala ones).

# --- Gemini (story + voice) ---
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Pick one with: node voice-test.js   (Charon, Algenib, Enceladus, Gacrux, Achernar, Sulafat)
GEMINI_TTS_VOICE=Gacrux,Sulafat
VOICE_SCRIPT=english
# Horror sound: lower pitch = deeper voice (0.85-1), echo amount (0 = off)
VOICE_PITCH=0.94
VOICE_REVERB=0.22

# --- Cloudflare Workers AI (free pictures) ---
CF_ACCOUNT_ID=paste-your-cloudflare-account-id
CF_API_TOKEN=paste-your-cloudflare-api-token

# --- YouTube (Client ID / Secret from the keep-your-eyes-shut Google Cloud project) ---
YT_CLIENT_ID=paste-your-client-id.apps.googleusercontent.com
YT_CLIENT_SECRET=paste-your-client-secret

# private = only you see it | unlisted | public
PRIVACY=private

# --- Video ---
SHORTS_PER_RUN=1
SHORT_SCENES=12
BRAND_TEXT=KEEP YOUR EYES SHUT
# Quiet dark hum under the voice (0 = off)
AMBIENCE_VOLUME=0.06
KEEP_DAYS=7
